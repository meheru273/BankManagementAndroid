<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    tools:context=".MainActivity">

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="76dp" />

    <!-- Bottom navigation -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:layout_gravity="bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="78dp"
            android:layout_gravity="bottom"
            android:background="@color/surface"
            android:elevation="14dp"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <LinearLayout
                    android:id="@+id/nav_home"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/nav_home_icon"
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:contentDescription="@string/tab_home"
                        android:src="@drawable/ic_home"
                        app:tint="@color/plum" />

                    <TextView
                        android:id="@+id/nav_home_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/tab_home"
                        android:textColor="@color/plum"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_accounts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/nav_accounts_icon"
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:contentDescription="@string/tab_accounts"
                        android:src="@drawable/ic_wallet"
                        app:tint="@color/nav_inactive" />

                    <TextView
                        android:id="@+id/nav_accounts_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/tab_accounts"
                        android:textColor="@color/nav_inactive"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/nav_bills"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/nav_bills_icon"
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:contentDescription="@string/tab_bills"
                        android:src="@drawable/ic_receipt"
                        app:tint="@color/nav_inactive" />

                    <TextView
                        android:id="@+id/nav_bills_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/tab_bills"
                        android:textColor="@color/nav_inactive"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/nav_profile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/nav_profile_icon"
                        android:layout_width="23dp"
                        android:layout_height="23dp"
                        android:contentDescription="@string/tab_profile"
                        android:src="@drawable/ic_user"
                        app:tint="@color/nav_inactive" />

                    <TextView
                        android:id="@+id/nav_profile_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/tab_profile"
                        android:textColor="@color/nav_inactive"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Raised center Scan button -->
        <FrameLayout
            android:id="@+id/nav_scan"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_circle_white"
            android:elevation="16dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_gradient_circle"
                android:contentDescription="@string/tab_scan"
                android:padding="16dp"
                android:src="@drawable/ic_scan"
                app:tint="@color/white" />
        </FrameLayout>
    </FrameLayout>

</FrameLayout>
