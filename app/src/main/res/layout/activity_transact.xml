<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flipper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!-- ===== AMOUNT ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="16dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/t_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_round14"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/tab_home"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/plum" />
            </FrameLayout>

            <TextView
                android:id="@+id/t_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Recipient (transfer / bill only) -->
        <LinearLayout
            android:id="@+id/t_recipient_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_round18"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_round12"
                android:backgroundTint="#F2E7ED">

                <ImageView
                    android:id="@+id/t_recipient_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/to_label"
                    android:src="@drawable/ic_user"
                    app:tint="@color/mauve" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/t_recipient_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/to_label"
                    android:textColor="@color/ink_soft"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/t_recipient_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="@string/recipient_hint"
                    android:inputType="text"
                    android:paddingTop="2dp"
                    android:paddingBottom="0dp"
                    android:textColor="@color/ink"
                    android:textColorHint="#B7ADB6"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- From -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_round18"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_round12"
                android:backgroundTint="#EFE6EA">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/from_label"
                    android:src="@drawable/ic_wallet"
                    app:tint="@color/plum" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/from_label"
                    android:textColor="@color/ink_soft"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/t_from"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/from_label"
                android:src="@drawable/ic_chevron_down"
                app:tint="@color/ink_soft" />
        </LinearLayout>

        <!-- Amount + chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/enter_amount"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/t_amount_big"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="৳ 0"
                android:textColor="@color/ink"
                android:textSize="46sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/t_chip1" style="@style/Chip" />

                <TextView android:id="@+id/t_chip2" style="@style/Chip" />

                <TextView android:id="@+id/t_chip3" style="@style/Chip" />

                <TextView android:id="@+id/t_chip4" style="@style/Chip" />
            </LinearLayout>
        </LinearLayout>

        <GridLayout
            android:id="@+id/t_amount_pad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="3" />

        <TextView
            android:id="@+id/t_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_round20"
            android:backgroundTint="@color/plum"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="@string/continue_label"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== PIN ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="16dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp">

        <FrameLayout
            android:id="@+id/t_pin_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_round14"
            android:elevation="2dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/tab_home"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/plum" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_gradient_circle">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/enter_your_pin"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/enter_your_pin"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/t_pin_sub"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textAlignment="center"
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:orientation="horizontal">

                <View android:id="@+id/t_dot0" style="@style/PinDot" />

                <View android:id="@+id/t_dot1" style="@style/PinDot" />

                <View android:id="@+id/t_dot2" style="@style/PinDot" />

                <View android:id="@+id/t_dot3" style="@style/PinDot" />
            </LinearLayout>
        </LinearLayout>

        <GridLayout
            android:id="@+id/t_pin_pad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3" />
    </LinearLayout>

    <!-- ===== SUCCESS ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="16dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_circle_white"
                android:backgroundTint="@color/green_in_bg">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/payment_successful"
                    android:src="@drawable/ic_check"
                    app:tint="@color/green_in" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/payment_successful"
                android:textColor="@color/ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/t_success_msg"
                android:layout_width="270dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAlignment="center"
                android:textColor="@color/ink_soft"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/t_success_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/ink"
                android:textSize="40sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_round20"
                android:elevation="3dp"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <LinearLayout style="@style/ReceiptRow">

                    <TextView style="@style/ReceiptKey" android:text="@string/from_label" />

                    <TextView
                        android:id="@+id/t_receipt_from"
                        style="@style/ReceiptVal" />
                </LinearLayout>

                <View style="@style/ReceiptDivider" />

                <LinearLayout style="@style/ReceiptRow">

                    <TextView style="@style/ReceiptKey" android:text="@string/reference" />

                    <TextView style="@style/ReceiptVal" android:text="TXN 8842 1907" />
                </LinearLayout>

                <View style="@style/ReceiptDivider" />

                <LinearLayout style="@style/ReceiptRow">

                    <TextView style="@style/ReceiptKey" android:text="@string/date_label" />

                    <TextView
                        android:id="@+id/t_receipt_date"
                        style="@style/ReceiptVal" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/t_done"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_round20"
            android:backgroundTint="@color/plum"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="@string/done"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/share_receipt"
            android:textColor="@color/plum"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</ViewFlipper>
